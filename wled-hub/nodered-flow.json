 {
  "id": "wh_batsig",
  "type": "function",
  "z": "wledhub_tab",
  "name": "Bat-signal 12 s",
  "func": "// flash = joue l'animation puis RESTAURE ce qui tournait avant.\n// Rien a memoriser cote Node-RED.\nmsg.topic = 'wledhub/panel01/flash';\nmsg.payload = { animation: 'batsignal', seconds: 12 };\nreturn msg;",
  "outputs": 1,
  "noerr": 0,
  "x": 420,
  "y": 80,
  "wires": [
   [
    "wh_out"
   ]
  ]
 },
