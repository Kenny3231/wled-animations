 {
  "id": "wh_setanim",
  "type": "function",
  "z": "wledhub_tab",
  "name": "animation = matrix",
  "func": "// Accepte l'identifiant (matrix) ou le nom lisible (Matrix - pluie digitale)\nmsg.topic = 'wledhub/panel01/set/animation';\nmsg.payload = 'matrix';\nreturn msg;",
