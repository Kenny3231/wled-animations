 {
  "id": "wh_msg",
  "type": "function",
  "z": "wledhub_tab",
  "name": "Texte puis flash 15 s",
  "func": "// Deux messages : on pose le texte, puis on declenche le flash.\nconst texte = msg.payload;\nreturn [[\n  { topic:'wledhub/panel01/set/text', payload: texte },\n  { topic:'wledhub/panel01/flash', payload:{ animation:'message', seconds:15 } }\n]];",
  "outputs": 1,
  "noerr": 0,
  "x": 440,
  "y": 240,
  "wires": [
   [
    "wh_out"
   ]
  ]
 },
